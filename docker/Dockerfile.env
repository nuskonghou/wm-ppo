# Environment-side image: the training loop (alf_final.py), the environment workers and the evaluation scripts, with
# the Python packages of the reported runs (Ubuntu 22.04, Python 3.10) and Java 11 for ScienceWorld. The launcher starts
# the GPU containers through the Docker socket, so the image also contains the Docker command-line client.
#   docker build -t wmppo-env -f docker/Dockerfile.env docker
FROM docker:27-cli AS dockercli

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-dev python-is-python3 build-essential cmake git curl ca-certificates gnupg \
 && curl -fsSL https://apt.corretto.aws/corretto.key | gpg --dearmor -o /usr/share/keyrings/corretto-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/corretto-keyring.gpg] https://apt.corretto.aws stable main" \
        > /etc/apt/sources.list.d/corretto.list \
 && apt-get update && apt-get install -y --no-install-recommends java-11-amazon-corretto-jdk \
 && rm -rf /var/lib/apt/lists/*
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY requirements-alfworld.txt requirements-scienceworld.txt /tmp/
RUN python3 -m venv /opt/venv-alfworld \
 && /opt/venv-alfworld/bin/pip install --no-cache-dir pip==26.2.1 \
 && PATH=/opt/venv-alfworld/bin:$PATH /opt/venv-alfworld/bin/pip install --no-cache-dir -r /tmp/requirements-alfworld.txt \
 && python3 -m venv /opt/venv-scienceworld \
 && /opt/venv-scienceworld/bin/pip install --no-cache-dir pip==26.2.1 \
 && /opt/venv-scienceworld/bin/pip install --no-cache-dir -r /tmp/requirements-scienceworld.txt \
 && /opt/venv-alfworld/bin/python -c "import alfworld, textworld, yaml; print('alfworld env ok')" \
 && /opt/venv-scienceworld/bin/python -c "import scienceworld, yaml; print('scienceworld env ok')"
ENV JAVA_HOME=/usr/lib/jvm/java-11-amazon-corretto
